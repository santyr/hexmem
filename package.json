{
  "name": "hexmem",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20 <26"
  },
  "files": [
    "dist",
    "migrations",
    "README.md",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "start:stdio": "node dist/index.js --stdio",
    "dev": "node --import tsx src/index.ts",
    "init": "node dist/cli/migrate.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "HEXMEM_DISABLE_EMBEDDINGS=1 node --import tsx --test tests/*.test.ts",
    "test:migrations": "node dist/cli/migrate.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.8.0",
    "express": "^5.1.0",
    "jstat": "^1.9.6",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.0",
    "@types/node": "25.5.0",
    "tsx": "^4.23.0",
    "typescript": "5.9.3"
  },
  "overrides": {
    "protobufjs": "^7.6.3",
    "@hono/node-server": "2.0.12",
    "body-parser": "2.3.0",
    "fast-uri": "4.1.1",
    "sharp": "0.35.3"
  },
  "allowScripts": {
    "better-sqlite3@12.8.0": true,
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.5": true
  }
}
